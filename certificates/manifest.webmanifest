{
  "name": "Akhnaton Certificates",
  "short_name": "Certificates",
  "description": "Calibration certificates from last year's data – Akhnaton calibration lab",
  "id": "/certificates/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "orientation": "any",
  "background_color": "#13294B",
  "theme_color": "#13294B",
  "lang": "en",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://bishoyloza-sketch.github.io/certificates/manifest.webmanifest"
    }
  ]
}